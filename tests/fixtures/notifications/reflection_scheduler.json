{
  "name": "reflection-scheduler-triggers",
  "component": "reflection_scheduler",
  "description": "Scheduler should reflect when interval elapsed, outside quiet hours, and cooldown passed.",
  "settings": {
    "interval_seconds": 3600,
    "cooldown_seconds": 300,
    "quiet_start_hour": 22,
    "quiet_end_hour": 7
  },
  "scenarios": [
    {
      "name": "first-time",
      "last_reflection": null,
      "now": "2024-01-01T12:00:00+00:00",
      "expected_should_reflect": true
    },
    {
      "name": "in-cooldown",
      "last_reflection": "2024-01-01T11:59:00+00:00",
      "now": "2024-01-01T12:00:00+00:00",
      "expected_should_reflect": false
    },
    {
      "name": "in-quiet-hours",
      "last_reflection": null,
      "now": "2024-01-01T23:00:00",
      "expected_should_reflect": false
    },
    {
      "name": "interval-not-elapsed",
      "last_reflection": "2024-01-01T11:00:00+00:00",
      "now": "2024-01-01T11:30:00+00:00",
      "expected_should_reflect": false
    }
  ]
}
