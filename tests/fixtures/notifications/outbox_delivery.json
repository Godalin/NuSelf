{
  "name": "outbox-delivery-lifecycle",
  "component": "notification_outbox",
  "description": "Outbox entries transition through pending, sent, failed, and dismissed states correctly.",
  "scenarios": [
    {
      "name": "add-and-list-pending",
      "actions": [
        { "action": "add", "entry": { "id": "t-001", "title": "Test", "body": "body", "status": "pending", "idempotency_key": "k1" } }
      ],
      "expected_list_pending": ["t-001"],
      "expected_list_sent": []
    },
    {
      "name": "mark-sent",
      "actions": [
        { "action": "add", "entry": { "id": "t-002", "title": "Test", "body": "body", "status": "pending", "idempotency_key": "k2" } },
        { "action": "deliver_success", "entry_id": "t-002" }
      ],
      "expected_list_pending": [],
      "expected_list_sent": ["t-002"]
    },
    {
      "name": "idempotency-prevents-duplicate",
      "actions": [
        { "action": "add", "entry": { "id": "t-003", "title": "Test", "body": "body", "status": "pending", "idempotency_key": "k3" } },
        { "action": "add", "entry": { "id": "t-004", "title": "Test", "body": "body", "status": "pending", "idempotency_key": "k3" } }
      ],
      "expected_list_pending": ["t-003"],
      "expected_list_sent": []
    }
  ]
}
